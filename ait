#!/bin/bash
# Public AIT command. State-changing work lives in focused scripts under bin.
set -euo pipefail

resolve_repo() {
  local source="${BASH_SOURCE[0]}" dir target
  while [ -L "$source" ]; do
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    target="$(readlink "$source")"
    case "$target" in
      /*) source="$target" ;;
      *) source="$dir/$target" ;;
    esac
  done
  cd -P "$(dirname "$source")" && pwd
}
REPO="$(resolve_repo)"

root_help() {
  cat <<'EOF'
AIT installs and operates the local AIT network.

Usage: ait <command> [arguments...]

Commands:
  init [path]       Enable or verify AIT in a project.
  start             Start the shared AIT services and verify health.
  stop              Stop the shared AIT services.
  status            Show read-only service and harness status.
  claude [args...]  Launch a Claude Code AIT session in the current directory.
  codex [args...]   Launch a Codex AIT session in the current directory.
  resume [query]    Find and resume one stopped AIT session by its handle.
  skills <command>  Install, remove, or inspect the delivery-coordination skill.
  help [command]    Show this help or a command's complete help page.
  version           Show this checkout's release version and Git revision.
  update            Update the managed checkout to the latest release.
  uninstall         Permanently remove this managed AIT installation.

Examples:
  ait init
  ait claude "join AIT as @my-project.test and wait"
  ait codex "join AIT as @my-project-build.test and wait"

Update policy:
  ait update accepts only the latest immutable full SemVer release. It never
  updates a development checkout, active session, dirty tree, or divergence.

Manual update sequence (development checkout only; not used by ait update):
  # Exit every AIT harness session first: /exit
  ait stop
  git pull --ff-only
  bin/install.sh --rebuild-only
  npm --prefix mcp run build
  npm --prefix appview run build
  bin/start-all.sh
  # Relaunch each session with bin/claude-session.sh or bin/codex-session.sh

Exit behavior:
  0  success or help
  1  prerequisite, conflict, service, or harness failure
  2  invalid command or argument

Run: ait help <command>
EOF
}

command_help() {
  case "$1" in
    init)
      cat <<'EOF'
ait init — enable or verify AIT in a project.

Usage: ait init [path]
Arguments: path is an existing project directory; without it AIT resolves the
current Git worktree root, or the nearest safe project marker outside Git.
Options: --help, -h.
Prerequisites: a healthy installed AIT core and Claude Code and/or Codex.
Changes: may add the exact AIT entry to <project>/.mcp.json; preserves unrelated
entries and creates no Codex project file.
Example: cd my-project && ait init
Normal result: prints the resolved project and ready/skipped harness rows.
Recovery: run `ait start`; pass `ait init "$PWD"` for an explicit override.
Exit behavior: 0 success, 1 prerequisite/conflict/native-harness failure, 2
invalid arguments.
EOF
      ;;
    start)
      cat <<'EOF'
ait start — start and verify the shared AIT services.

Usage: ait start
Arguments: none. Options: --help, -h.
Prerequisites: macOS, the installed checkout, dependencies, builds, and env.
Changes: starts PLC, PDS, AppView, and Codex only when Codex is installed.
Example: ait start
Normal result: prints the health table after successful probes.
Recovery: inspect `ait status` and /tmp/ait-*.err; stop before repairs.
Exit behavior: 0 healthy, 1 service failure, 2 invalid arguments.
EOF
      ;;
    stop)
      cat <<'EOF'
ait stop — stop the shared AIT services.

Usage: ait stop
Arguments: none. Options: --help, -h.
Prerequisites: the installed checkout; services may already be stopped.
Changes: stops AIT services identified by their ports/socket and removes PID files.
Example: ait stop
Normal result: every AIT service is stopped or reported not running.
Recovery: inspect `ait status` and the reported process owner.
Exit behavior: 0 success, 1 stop failure, 2 invalid arguments.
EOF
      ;;
    status)
      cat <<'EOF'
ait status — show read-only AIT service and harness status.

Usage: ait status
Arguments: none. Options: --help, -h.
Prerequisites: the installed checkout and curl for HTTP probes.
Changes: none; status never starts, stops, writes, or repairs services.
Example: ait status
Normal result: shows running/unreachable core services and Codex running,
unreachable, or skipped (not installed).
Recovery: run `ait start` when a required service is unreachable.
Exit behavior: 0 when the required core is healthy, 1 otherwise, 2 invalid
arguments.
EOF
      ;;
    claude)
      cat <<'EOF'
ait claude — launch the existing Claude AIT session launcher.

Usage: ait claude [args...]
Arguments/options: all remaining arguments pass unchanged to the launcher.
Prerequisites: healthy AIT core, Claude Code, built MCP, and an exact or
pending-approval ait-protocol project entry.
Changes: launches Claude in the caller's current directory; no service or
project configuration is changed.
Example: ait claude "join AIT as @my-project.test and wait"
Normal result: Claude owns the terminal, signals, and exit status.
Recovery: run `ait init` for the project, then `ait start`.
Exit behavior: 0/native success, 1 prerequisite/harness failure, 2 invalid
AIT arguments.
EOF
      ;;
    resume)
      cat <<'EOF'
ait resume — find and resume an existing AIT session by its handle.

Usage: ait resume [query]
Arguments: optional case-insensitive handle, harness, project, Claude UUID, or
Codex thread ID. Without an exact identifier, choose a numbered result.
Prerequisites: healthy AIT core, built MCP, an installed Claude Code or Codex,
and the original project directory and AIT identity still present on disk.
Changes: starts only the selected existing session in its original project;
discovery reads existing harness records, excludes live sessions, and never
writes a session catalog.
Example: ait resume @my-project-spec.test
Normal result: resumes the selected session with its original AIT identity.
Recovery: no match, ambiguity, EOF, and Ctrl-C launch nothing.
Exit behavior: 0 when a launcher exits successfully, 1 when no session can be
selected or discovery fails, 130 when selection is interrupted, 2 invalid
arguments.
EOF
      ;;
    codex)
      cat <<'EOF'
ait codex — launch the existing Codex AIT session launcher.

Usage: ait codex [args...]
Arguments/options: all remaining arguments pass unchanged to the launcher.
Prerequisites: healthy AIT core, Codex, built MCP, and the executable launcher.
Changes: launches Codex in the caller's current directory; no project file or
core service is auto-started.
Example: ait codex "join AIT as @my-project-build.test and wait"
Normal result: Codex owns the terminal, signals, and exit status.
Recovery: install Codex if missing, run `ait start`, and retry.
Exit behavior: 0/native success, 1 prerequisite/harness failure, 2 invalid
AIT arguments.
EOF
      ;;
    skills)
      cat <<'EOF'
ait skills — manage the machine-wide delivery-coordination skill.

Usage: ait skills <install|remove|status>
Arguments: install, remove, or status. Options: --help, -h.
Targets: ~/.claude/skills/delivery-coordination and
~/.agents/skills/delivery-coordination.
Prerequisites: the managed checkout and a detected Claude Code or Codex for
install; status and remove are ownership-safe.
Changes: install creates only missing links to this checkout's skill source;
remove deletes only links resolving to that exact source; status never writes.
Discovery: harness availability is checked when each command runs.
Conflict: regular files, directories, broken links, and foreign links remain
untouched and are reported with a safe recovery.
Example: ait skills install
Normal result: every mutation says to start a new harness session for a
guaranteed result.
Recovery: move a foreign target aside, then rerun the same command.
Exit behavior: 0 success, 1 source/harness/conflict/filesystem failure, 2
invalid command or arguments.
EOF
      ;;
    help)
      cat <<'EOF'
ait help — show the canonical AIT command manual.

Usage: ait help [command]
Arguments: optional command: init, start, stop, status, claude, codex, resume,
skills, help, version, update, or uninstall. Options: --help, -h.
Prerequisites: none.
Changes: none; help is read-only and works with services stopped.
Example: ait help init
Normal result: exits zero with the requested page.
Recovery: use `ait help` for the command list.
Exit behavior: 0 success, 2 unknown command.
EOF
      ;;
    version)
      cat <<'EOF'
ait version — show this checkout's release version and Git revision.

Usage: ait version
Arguments: none. Options: --help, -h.
Prerequisites: a valid Git checkout and VERSION; no network is contacted.
Changes: none.
Example: ait version
Normal result: prints the release version, short Git revision, and development
when this checkout is not the exact commit of a published release.
Recovery: reinstall the managed checkout if the version cannot be read.
Exit behavior: 0 success, 1 invalid checkout, 2 invalid arguments.
EOF
      ;;
    update)
      cat <<'EOF'
ait update — update the managed AIT checkout to one published release.

Usage: ait update
Arguments: none. Options: --help, -h.
Prerequisites: the installer-owned checkout, a clean tree, no active AIT
sessions, and services fully ready or fully stopped.
Changes: fetches one latest immutable full SemVer release, verifies its tag,
commit, VERSION, and installer digest, rebuilds, and restores service state.
It preserves environment files, data, and skill-link targets.
Refuses: development/package-manager checkouts, drafts, prereleases, mutable
releases, divergence, downgrades, dirty state, active sessions, partial
services, and a live update owner.
Example: ait update
Normal result: prints the verified release, rebuild, restored services, and
release notes URL. An equal release is a read-only no-op.
Recovery: failures before a service start attempt print exact reset commands;
after a start attempt they require fix-forward and never recommend reset.
Exit behavior: 0 updated or already current, 1 refusal or failed recovery,
2 invalid arguments.
EOF
      ;;
    uninstall)
      cat <<'EOF'
ait uninstall — permanently remove this managed AIT installation.

Usage: ait uninstall
Arguments: none. Options: --help, -h.
Prerequisites: the installer-owned checkout and CLI link, no active update, and
no harness session using this checkout's MCP server.
Changes: after the literal confirmation `uninstall AIT`, stops AIT and removes
its managed checkout, local plc_directory database, identities, state, sockets,
logs, CLI link, skill links, and launchd agents. It creates no backup or retained
copy.
Preserves: project .mcp.json entries and shared prerequisites, including the
PostgreSQL installation and unrelated databases.
Example: ait uninstall
Normal result: the machine-level AIT installation is absent.
Recovery: reinstall with the public release command printed by the uninstaller.
Exit behavior: 0 success or cancellation before confirmation, 1 refusal or
cleanup failure, 2 invalid arguments, 130 interrupted confirmation.
EOF
      ;;
    *)
      echo "unknown help topic: $1" >&2
      echo "Run: ait help" >&2
      return 2
      ;;
  esac
}

invalid_args() {
  echo "invalid arguments: $*" >&2
  echo "Run: ait help" >&2
  exit 2
}

refuse_operator_command() {
  local command_name="$1" marker
  case "$command_name" in
    resume|uninstall) ;;
    *) return 0 ;;
  esac
  for marker in CLAUDECODE CLAUDE_CODE_SESSION_ID CLAUDE_CODE_ENTRYPOINT \
    CODEX_SESSION_ID CODEX_THREAD_ID AIT_SESSION_ID AI_AGENT; do
    if [ -n "${!marker:-}" ]; then
      echo "error: refusing to run ait $command_name from an agent shell ($marker is set)" >&2
      echo "ask the human operator to run: ait $command_name" >&2
      echo "this deters accidental use; it is not a security boundary against a same-user full-privilege shell" >&2
      exit 2
    fi
  done
  if [ ! -t 0 ]; then
    echo "error: refusing to run ait $command_name without a human terminal" >&2
    echo "ask the human operator to run: ait $command_name" >&2
    echo "this deters accidental use; it is not a security boundary against a same-user full-privilege shell" >&2
    exit 2
  fi
}

case "${1:-help}" in
  help)
    shift || true
    case "${1:-}" in
      "") [ "$#" -eq 0 ] || invalid_args "$@"; root_help ;;
      -h|--help) [ "$#" -eq 1 ] || invalid_args "$@"; command_help help ;;
      *) [ "$#" -eq 1 ] || invalid_args "$@"; command_help "$1" ;;
    esac
    ;;
  --help|-h)
    [ "$#" -eq 1 ] || invalid_args "$@"
    root_help
    ;;
  version|--version)
    if [ "${1:-}" = "version" ] && { [ "${2:-}" = "-h" ] || [ "${2:-}" = "--help" ]; }; then
      [ "$#" -eq 2 ] || invalid_args "$@"
      command_help version
    else
      [ "$#" -eq 1 ] || invalid_args "$@"
      version_file="$REPO/VERSION"
        [ -f "$version_file" ] || { echo "error: VERSION is missing from $REPO" >&2; exit 1; }
        version="$(tr -d '[:space:]' < "$version_file")"
        printf '%s' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$' || {
          echo "error: invalid VERSION: $version" >&2; exit 1;
        }
        short="$(git -C "$REPO" rev-parse --short=16 HEAD)"
        tag="$(git -C "$REPO" tag --points-at HEAD "v$version" 2>/dev/null || true)"
        if [ -z "$tag" ] && [ "$(git -C "$REPO" rev-parse "refs/ait-release/v$version""^{commit}" 2>/dev/null || true)" = "$(git -C "$REPO" rev-parse HEAD)" ]; then
          tag="v$version"
        fi
        if [ "$tag" = "v$version" ]; then
          printf 'AIT %s (%s)\n' "$version" "$short"
        else
          printf 'AIT %s (%s) development\n' "$version" "$short"
        fi
    fi
    ;;
  init)
    if [ "${2:-}" = "-h" ] || [ "${2:-}" = "--help" ]; then
      [ "$#" -eq 2 ] || invalid_args "$@"
      command_help init
    else
      exec "$REPO/bin/install.sh" --init "${@:2}"
    fi
    ;;
  start|stop|status)
    if [ "${2:-}" = "-h" ] || [ "${2:-}" = "--help" ]; then
      [ "$#" -eq 2 ] || invalid_args "$@"
      command_help "$1"
    else
      [ "$#" -eq 1 ] || invalid_args "$@"
      case "$1" in
        start|stop)
          lock="${XDG_STATE_HOME:-$HOME/.local/state}/ait-protocol/update.lock"
          if [ -e "$lock" ]; then
            lock_pid="$(cat "$lock/pid" 2>/dev/null || true)"
            if [ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null; then
              echo "error: AIT update is already running (pid $lock_pid)" >&2
            else
              echo "error: stale AIT update lock at $lock (pid ${lock_pid:-unknown})" >&2
              echo "  recovery: rm -f '$lock/pid' '$lock/state' && rmdir '$lock', then rerun ait $1" >&2
            fi
            exit 1
          fi
          ;;
      esac
      case "$1" in
        start) exec "$REPO/bin/start-all.sh" ;;
        stop) exec "$REPO/bin/stop-all.sh" ;;
        status) exec "$REPO/bin/status.sh" ;;
      esac
    fi
    ;;
  update)
    if [ "${2:-}" = "-h" ] || [ "${2:-}" = "--help" ]; then
      [ "$#" -eq 2 ] || invalid_args "$@"
      command_help update
    else
      [ "$#" -eq 1 ] || invalid_args "$@"
      exec "$REPO/bin/update.sh"
    fi
    ;;
  resume)
    if [ "${2:-}" = "-h" ] || [ "${2:-}" = "--help" ]; then
      [ "$#" -eq 2 ] || invalid_args "$@"
      command_help resume
    else
      [ "$#" -le 2 ] || invalid_args "$@"
      refuse_operator_command resume
      selector="$REPO/mcp/dist/sessionPicker.js"
      [ -f "$selector" ] || {
        echo "error: built session selector is missing; run: npm --prefix '$REPO/mcp' run build" >&2
        exit 1
      }
      selection="$(node "$selector" "${2:-}")" || exit $?
      IFS=$'\t' read -r harness project identifier <<< "$selection"
      [ -n "$harness" ] && [ -n "$project" ] && [ -n "$identifier" ] || {
        echo "error: session selector returned no resumable session" >&2
        exit 1
      }
      cd -- "$project"
      exec "$REPO/bin/install.sh" --launch "$harness" --resume "$identifier"
    fi
    ;;
  uninstall)
    if [ "${2:-}" = "-h" ] || [ "${2:-}" = "--help" ]; then
      [ "$#" -eq 2 ] || invalid_args "$@"
      command_help uninstall
    else
      [ "$#" -eq 1 ] || invalid_args "$@"
      refuse_operator_command uninstall
      exec "$REPO/bin/uninstall.sh"
    fi
    ;;
  claude|codex)
    if [ "${2:-}" = "-h" ] || [ "${2:-}" = "--help" ]; then
      [ "$#" -eq 2 ] || invalid_args "$@"
      command_help "$1"
    else
      case "${2:-}" in
        --resume|-r|--session)
          if [ "$#" -ge 3 ] && [ -n "${3:-}" ]; then
            echo "error: public resume flags were replaced; use: ait resume \"$3\"" >&2
          else
            echo "error: public resume flags were replaced; use: ait resume" >&2
          fi
          exit 2
          ;;
        --resume-last)
          echo "error: public resume flags were replaced; use: ait resume" >&2
          exit 2
          ;;
      esac
      exec "$REPO/bin/install.sh" --launch "$1" "${@:2}"
    fi
    ;;
  skills)
    case "${2:-}" in
      ""|-h|--help)
        [ "$#" -eq 1 ] || [ "$#" -eq 2 ] || invalid_args "$@"
        command_help skills
        ;;
      install|remove|status)
        if [ "${3:-}" = "-h" ] || [ "${3:-}" = "--help" ]; then
          [ "$#" -eq 3 ] || invalid_args "$@"
          command_help skills
        else
          [ "$#" -eq 2 ] || invalid_args "$@"
          exec "$REPO/bin/install-skill.sh" "--$2"
        fi
        ;;
      *) invalid_args "$@" ;;
    esac
    ;;
  *)
    echo "unknown command: $1" >&2
    echo "Run: ait help" >&2
    exit 2
    ;;
esac
