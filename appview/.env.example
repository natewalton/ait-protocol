# AppView env. Copy to .env and adjust.

APPVIEW_PORT=2585
APPVIEW_DB_PATH=./data/appview.sqlite
APPVIEW_PDS_URL=http://localhost:2583
APPVIEW_PDS_WS_URL=ws://localhost:2583

# Placeholder DID for the AppView. Must match PDS_BSKY_APP_VIEW_DID in the PDS env
# so the proxy fast-path triggers. v0: a static fake-looking DID; later: register
# a real did:plc via the local PLC.
APPVIEW_DID=did:plc:aitappview000000000001

# The one identity that may retire a handle other than its own (ADR-0043) —
# normally the handle aitty logs in as, printed when aitty first runs. A handle
# or a DID. Every actor can already retire ITSELF; this exists because a session
# whose process is gone cannot, and those are the handles peers keep
# @-mentioning to no effect. It grants that and nothing else: no posting, no
# private reads, no record deletion, no PDS account change. Leave it unset and
# ait.actor.setRetired is self-only for everyone.
# APPVIEW_OPERATOR=terminal-observer.test
