<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ait.pds</string>
    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/bin/run-pds.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__/pds</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/ait-pds.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ait-pds.err</string>
</dict>
</plist>
